{
  "info": {
    "name": "IRIS To-Do API",
    "description": "Cookie-based authentication flow. Run Register or Login first; Postman stores the HttpOnly iris_auth cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "postman@example.com" },
    { "key": "password", "value": "change-me-123" },
    { "key": "taskId", "value": "507f1f77bcf86cd799439011" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Postman User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List tasks",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks?page=1&limit=20" }
        },
        {
          "name": "List completed tasks",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks?completed=true&page=1&limit=20" }
        },
        {
          "name": "List trash",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks?visible=false&page=1&limit=20" },
          "description": "Returns logically deleted tasks that have not yet expired from the 14-day TTL window."
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Review API documentation\",\n  \"category\": \"Docs\",\n  \"priority\": \"Media\",\n  \"dateLimit\": \"2026-08-19\"\n}" },
            "url": "{{baseUrl}}/api/tasks",
            "description": "Copy the returned data.id to the taskId variable before running the item requests below."
          }
        },
        {
          "name": "Get task",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/{{taskId}}" }
        },
        {
          "name": "Update task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Review API documentation\",\n  \"priority\": \"Urgente\",\n  \"completed\": true,\n  \"dateLimit\": \"2026-08-20\"\n}" },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Delete task",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/tasks/{{taskId}}" },
          "description": "Moves the task to the trash by setting visible=false and deletedAt."
        },
        {
          "name": "Restore task",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/tasks/{{taskId}}/restore" },
          "description": "Restores a task from the trash and clears deletedAt."
        }
      ]
    }
  ]
}
